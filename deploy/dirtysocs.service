[Unit]
Description=DirtySOCS Hybrid Kernel-Observability & AI SOC Analyst Daemon
Documentation=https://github.com/87Supreme-cell/DirtySOCS
After=network.target local-fs.target systemd-journald.service
Wants=systemd-journald.service

[Service]
Type=simple
User=root
Group=root

# Binary path and runtime configuration
ExecStart=/usr/bin/dirtysocs-daemon --socket-path /run/dirtysocs/dirtysocs.sock --strict-hil
Restart=always
RestartSec=3s

# Runtime directory (/run/dirtysocs) automatically managed by systemd
RuntimeDirectory=dirtysocs
RuntimeDirectoryMode=0755

# Kernel Capability & Security Hardening Bounds
# Requires BPF, perfmon, tracing, network admin, and atomic pidfd signaling
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE CAP_KILL
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE CAP_KILL

# Filesystem Sandboxing Protections
ProtectSystem=strict
ReadWritePaths=/run/dirtysocs /var/log/dirtysocs /tmp
ProtectHome=read-only
PrivateTmp=false

# Memory & Resource Bounding (Zero host degradation guarantee)
MemoryMax=64M
MemoryHigh=48M
CPUQuota=10%

# Clean shutdown signal
KillSignal=SIGINT
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
